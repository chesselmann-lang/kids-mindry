# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Anthropic AI ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Default model: claude-sonnet-4-6 (kostengünstiger als Opus, höhere Qualität als Haiku)
# Alternativen: claude-haiku-4-5-20251001 (schnell/billig) | claude-opus-4-6 (maximal)
AI_MODEL=claude-sonnet-4-6

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_SITE_ID=<uuid>
NEXT_PUBLIC_APP_URL=https://kids.mindry.de
